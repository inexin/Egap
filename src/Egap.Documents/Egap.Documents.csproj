<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egap.Documents</RootNamespace>
    <PackageId>Egap.Documents</PackageId>
    <VersionPrefix>1.1.0</VersionPrefix>
    <Description>Flow documents for .NET: one editable document model with Markdown, DOCX and HTML readers and writers and a page layout engine that draws onto any Egami canvas.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Pages are laid out with Egami's fonts and drawn on Egami's canvas (Phase 6 design Q11, Q13); Egap.Fonts is the last stop of
    the font chain (Q12). Never Egap.Pdf (hub decision 2026-10-11): PDF export lives in Egap.Pdf.Layout (Q2).
  -->
  <ItemGroup>
    <PackageReference Include="Egami.Drawing" />
    <PackageReference Include="Egami.Metafiles" />
    <PackageReference Include="Egami.Svg" />
    <PackageReference Include="Egami.Css" />
    <ProjectReference Include="../Egap.Fonts/Egap.Fonts.csproj" />
  </ItemGroup>

  <!-- HTML named character references (WHATWG, CC BY 4.0; THIRD-PARTY-NOTICES.md), for the Markdown and HTML readers. -->
  <ItemGroup>
    <EmbeddedResource Include="Html/entities.txt" LogicalName="Egap.Documents.Html.entities.txt" />
    <EmbeddedResource Include="Html/html.css" LogicalName="Egap.Documents.Html.html.css" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- The compare harness runs the CommonMark spec (CC BY-SA, compare repo only) against the parser's own HTML rendering. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Egap.Documents.Tests" />
    <InternalsVisibleTo Include="Egap.Documents.Fuzz" />
    <InternalsVisibleTo Include="Compare" />
    <InternalsVisibleTo Include="Compare.Tests" />
    <InternalsVisibleTo Include="Compare.Benchmarks" />
  </ItemGroup>

</Project>
