<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egap.Documents</RootNamespace>
    <PackageId>Egap.Documents</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Flow documents for .NET: one editable document model with Markdown, DOCX and HTML readers and writers and a page layout engine that draws onto any Egami canvas.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Pages are laid out with Egami's fonts and drawn on Egami's canvas (Phase 6 design Q11, Q13); Egap.Fonts is the last stop of
    the font chain (Q12). Never Egap.Pdf (hub decision 2026-10-11): PDF export lives in Egap.Pdf.Layout (Q2).
  -->
  <ItemGroup>
    <PackageReference Include="Egami.Drawing" />
    <ProjectReference Include="../Egap.Fonts/Egap.Fonts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egap.Documents.Tests" />
  </ItemGroup>

</Project>
