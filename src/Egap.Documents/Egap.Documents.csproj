<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egap.Documents</RootNamespace>
    <PackageId>Egap.Documents</PackageId>
    <VersionPrefix>1.2.0</VersionPrefix>
    <Description>Flow documents for .NET: one editable document model with Markdown, DOCX and HTML readers and writers, a page layout engine that draws onto any Egami canvas, PDF export with links, outline and tags, and PDF pages analysed back into documents.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Pages are laid out with Egami's fonts and drawn on Egami's canvas; Egami.Fonts.Substitutes is the last stop of the font
    chain. Egap.Pdf for PDF export and PDF to document, which live here since 2.0.0 (namespace Egap.Documents.Pdf).
  -->
  <ItemGroup>
    <ProjectReference Include="../Egap.Pdf/Egap.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Egami.Drawing" />
    <PackageReference Include="Egami.Barcodes" />
    <PackageReference Include="Egami.Metafiles" />
    <PackageReference Include="Egami.Svg" />
    <PackageReference Include="Egami.Css" />
    <PackageReference Include="Egami.Fonts.Substitutes" />
  </ItemGroup>

  <!-- HTML named character references (WHATWG, CC BY 4.0; THIRD-PARTY-NOTICES.md), for the Markdown and HTML readers. -->
  <ItemGroup>
    <EmbeddedResource Include="Html/entities.txt" LogicalName="Egap.Documents.Html.entities.txt" />
    <EmbeddedResource Include="Html/html.css" LogicalName="Egap.Documents.Html.html.css" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- The compare harness runs the CommonMark spec (CC BY-SA, compare repo only) against the parser's own HTML rendering. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Egap.Documents.Tests" />
    <InternalsVisibleTo Include="Egap.Documents.Fuzz" />
    <InternalsVisibleTo Include="Egap.Pdf.Fuzz" />
    <InternalsVisibleTo Include="Compare" />
    <InternalsVisibleTo Include="Compare.Tests" />
    <InternalsVisibleTo Include="Compare.Benchmarks" />
  </ItemGroup>

</Project>
