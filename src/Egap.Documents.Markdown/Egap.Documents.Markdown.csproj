<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egap.Documents</RootNamespace>
    <PackageId>Egap.Documents.Markdown</PackageId>
    <VersionPrefix>2.1.0</VersionPrefix>
    <Description>Markdown for Egap.Documents: CommonMark and GitHub Markdown read into the document model and written from it, with front matter, images and Markdown to PDF.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Claimed because tests/Egap.Documents.Markdown.AotSmoke publishes with Native AOT without a warning. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- A format add-on: it builds on Egap.Documents and registers its format there; the core never references it. -->
  <ItemGroup>
    <ProjectReference Include="../Egap.Documents/Egap.Documents.csproj" />
  </ItemGroup>

  <!-- Markdig (BSD-2-Clause, approved in docs/references.md) parses; the reader maps its syntax tree onto the model. -->
  <ItemGroup>
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <!-- The compare harness runs the CommonMark spec (CC BY-SA, compare repo only) against the parser's own HTML rendering. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Egap.Documents.Markdown.Tests" />
    <InternalsVisibleTo Include="Egap.Documents.Fuzz" />
    <InternalsVisibleTo Include="Compare" />
    <InternalsVisibleTo Include="Compare.Tests" />
    <InternalsVisibleTo Include="Compare.Benchmarks" />
  </ItemGroup>

</Project>
