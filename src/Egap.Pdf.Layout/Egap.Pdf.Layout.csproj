<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egap.Pdf.Layout</RootNamespace>
    <PackageId>Egap.Pdf.Layout</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Description>The bridge between Egap.Documents and Egap.Pdf: flow documents saved as PDF with links, outline and tags, and PDF pages analysed back into flow documents.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- The only package that knows both (Phase 6 design Q2): document to PDF (6.4) and PDF to document (3.6). -->
  <ItemGroup>
    <ProjectReference Include="../Egap.Documents/Egap.Documents.csproj" />
    <ProjectReference Include="../Egap.Pdf/Egap.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egap.Pdf.Layout.Tests" />
    <InternalsVisibleTo Include="Compare" />
    <InternalsVisibleTo Include="Compare.Tests" />
    <InternalsVisibleTo Include="Compare.Benchmarks" />
    <InternalsVisibleTo Include="Egap.Pdf.Fuzz" />
  </ItemGroup>

</Project>
