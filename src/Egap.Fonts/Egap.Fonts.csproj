<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egap.Fonts</RootNamespace>
    <PackageId>Egap.Fonts</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Description>Open, metric-compatible substitutes for the fonts documents name most: Liberation Sans, Serif and Mono for Helvetica, Arial, Times, Times New Roman, Courier and Courier New, Carlito for Calibri and Caladea for Cambria (SIL OFL 1.1).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Egami.Fonts" />
  </ItemGroup>

  <!-- The fonts and their licences, unchanged (SIL OFL 1.1; THIRD-PARTY-NOTICES.md). The licences ship with the fonts. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts/*.ttf;Fonts/*-OFL.txt" LogicalName="Egap.Fonts.%(Filename)%(Extension)" />
    <None Include="Fonts/*-OFL.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
