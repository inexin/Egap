<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egap.Documents</RootNamespace>
    <PackageId>Egap.Documents.Html</PackageId>
    <VersionPrefix>$(EgapVersion)</VersionPrefix>
    <Description>HTML for Egap.Documents: HTML and XHTML read into the document model through the CSS cascade and written from it, with flexbox and grid layout, rounded and shadowed boxes, positioned boxes, @page rules and margin boxes, HTML to PDF, and HTML stamps and page bands.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Claimed because tests/Egap.Documents.Html.AotSmoke publishes with Native AOT without a warning. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- A format add-on: it builds on Egap.Documents and registers its format there; the core never references it. -->
  <ItemGroup>
    <ProjectReference Include="../Egap.Documents/Egap.Documents.csproj" />
  </ItemGroup>

  <!--
    AngleSharp (MIT, approved in docs/references.md) parses; Egami.Css runs the cascade, @page rules and margin boxes over the
    parsed tree.
  -->
  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Egami.Css" />
  </ItemGroup>

  <!-- HTML's default style sheet. -->
  <ItemGroup>
    <EmbeddedResource Include="html.css" LogicalName="Egap.Documents.Html.html.css" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egap.Documents.Html.Tests" />
    <InternalsVisibleTo Include="Egap.Documents.Fuzz" />
    <InternalsVisibleTo Include="Compare" />
    <InternalsVisibleTo Include="Compare.Tests" />
    <InternalsVisibleTo Include="Compare.Benchmarks" />
  </ItemGroup>

</Project>
