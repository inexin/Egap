<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Egap.Preview</RootNamespace>
    <PackageId>Egap.Preview</PackageId>
    <VersionPrefix>$(EgapVersion)</VersionPrefix>
    <Description>egap-preview: a live preview of Egap documents on a local web page. It shows the pages a program sends with Document.ShowPreview() as the program runs under dotnet watch, or a DOCX file, drawn again whenever it changes.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>egap-preview</ToolCommandName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Only Egap's own packages: the server is .NET's TcpListener, the page plain HTML. -->
  <ItemGroup>
    <ProjectReference Include="../Egap.Documents/Egap.Documents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <InternalsVisibleTo Include="Egap.Preview.Tests" />
  </ItemGroup>

</Project>
