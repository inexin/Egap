<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egap.Pdf</RootNamespace>
    <PackageId>Egap.Pdf</PackageId>
    <VersionPrefix>1.1.0</VersionPrefix>
    <Description>A fully managed, MIT-licensed PDF library for .NET.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Egami's codecs, fonts and canvas (Phase 3 design Q2): the only shipped dependencies allowed in src/ (checked in ci.yml). -->
  <ItemGroup>
    <PackageReference Include="Egami.Drawing" />
  </ItemGroup>

  <!-- Adobe's Core14 AFM files, unchanged, with the notice their licence says must go with them (THIRD-PARTY-NOTICES.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts/Standard14/*.afm" LogicalName="Egap.Pdf.Fonts.%(Filename).afm" />
    <EmbeddedResource Include="Fonts/Standard14/MustRead.txt" LogicalName="Egap.Pdf.Fonts.MustRead.txt" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Adobe's Glyph List and predefined CMaps (BSD-3-Clause, THIRD-PARTY-NOTICES.md): the CMaps packed by tools/pack-cmaps.py. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts/Data/glyphlist.txt" LogicalName="Egap.Pdf.Fonts.glyphlist.txt" />
    <EmbeddedResource Include="Fonts/Data/zapfdingbats.txt" LogicalName="Egap.Pdf.Fonts.zapfdingbats.txt" />
    <EmbeddedResource Include="Fonts/Data/cmaps.bin" LogicalName="Egap.Pdf.Fonts.cmaps.bin" />
  </ItemGroup>

  <!-- Substitutes for fonts that are not embedded (Phase 4 design Q5): Foxit's fonts (BSD-3-Clause) and Noto Sans (OFL 1.1), THIRD-PARTY-NOTICES.md. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts/Substitutes/*.pfb;Fonts/Substitutes/*.ttf;Fonts/Substitutes/Noto-OFL.txt;Fonts/Substitutes/LICENSE_FOXIT" LogicalName="Egap.Pdf.Fonts.Substitutes.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egap.Pdf.Tests" />
    <InternalsVisibleTo Include="Egap.Pdf.Benchmarks" />
    <InternalsVisibleTo Include="Egap.Pdf.Fuzz" />
  </ItemGroup>

</Project>
