{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/inexin/Egap/main/docs/schemas/egap-workflow-1.json",
  "title": "egap workflow",
  "description": "The steps of 'egap run' as a file: one object per step, with the step's options as properties named as on the command line without the dashes, and its arguments by their names. 'egap run --list' lists the steps and their options.",
  "type": "object",
  "required": [ "egap", "steps" ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "egap": { "description": "The workflow format's version.", "const": 1 },
    "description": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "value": {
      "description": "An option's value: text as the command line writes it (a page range, a date, a path), a number, true or false, or a list for an option given more than once.",
      "type": [ "string", "number", "boolean", "array" ],
      "items": { "type": [ "string", "number" ] }
    },
    "step": {
      "type": "object",
      "required": [ "op" ],
      "properties": {
        "op": { "description": "The step's name.", "enum": [ "pages", "append", "metadata", "strip-metadata", "encrypt", "decrypt", "optimize", "impose", "stamp", "redact", "sanitize", "save" ] }
      },
      "additionalProperties": { "$ref": "#/$defs/value" }
    }
  }
}
