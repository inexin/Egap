{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/Egap.Pdf",
          "files": [ "Egap.Pdf.csproj" ]
        },
        {
          "src": "../src/Egap.Documents",
          "files": [ "Egap.Documents.csproj" ]
        },
        {
          "src": "../src/Egap.Pdf.Layout",
          "files": [ "Egap.Pdf.Layout.csproj" ]
        },
        {
          "src": "../src/Egap.Fonts",
          "files": [ "Egap.Fonts.csproj" ]
        }
      ],
      "dest": "api",
      "properties": { "TargetFramework": "net10.0" }
    }
  ],
  "build": {
    "content": [
      { "files": [ "index.md", "toc.yml", "articles/**/*.md", "articles/**/toc.yml", "api/**.yml", "api/index.md" ] }
    ],
    "resource": [
      { "files": [ "images/**" ] }
    ],
    "output": "_site",
    "template": [ "default", "modern", "template" ],
    "globalMetadata": {
      "_appName": "Egap",
      "_appTitle": "Egap",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/favicon.ico",
      "_enableSearch": true
    }
  }
}
