w:t xml:space="preserve"> and to obtain comments</w:t></w:r><w:r><w:t>.</w:t></w:r><w:r w:rsidR="005A4303"><w:t xml:space="preserve">  The following items were discussed.</w:t></w:r></w:p><w:p w14:paraId="4195FB2E" w14:textId="77777777" w:rsidR="005A4303" w:rsidRDefault="005A4303"/><w:p w14:paraId="31D1E310" w14:textId="77777777" w:rsidR="00E769BE" w:rsidRDefault="005A4303"><w:r><w:t>Felix Mestey</w:t></w:r><w:r w:rsidR="00BC2AED"><w:t xml:space="preserve"> and Dave Pamplin</w:t></w:r><w:r w:rsidR="00601127"><w:t>, DOD, stated that they may send</w:t></w:r><w:r><w:t xml:space="preserve"> some comments regarding the potential impact of the proposed rule on small refiners</w:t></w:r><w:r w:rsidR="009D386C"><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">and </w:t></w:r><w:r w:rsidR="00601127"><w:t xml:space="preserve">the </w:t></w:r><w:r><w:t>resulting effect on DOD</w:t></w:r><w:r w:rsidR="00105238"><w:t xml:space="preserve"> issuing</w:t></w:r><w:r w:rsidR="008F443E"><w:t xml:space="preserve"> small and </w:t></w:r><w:r><w:t>disadvantaged business contracts.</w:t></w:r><w:r w:rsidR="009D386C"><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="5C009E00" w14:textId="77777777" w:rsidR="005A4303" w:rsidRDefault="005A4303"/><w:p w14:paraId="1EBA40E4" w14:textId="77777777" w:rsidR="005A4303" w:rsidRDefault="008F443E"><w:r><w:t xml:space="preserve">Mitch Baer, DOE, </w:t></w:r><w:r w:rsidR="005A4303"><w:t xml:space="preserve">requested </w:t></w:r><w:r w:rsidR="00BC2AED"><w:t xml:space="preserve">the Regulatory Impacts Analysis (RIA) and </w:t></w:r><w:r w:rsidR="005A4303"><w:t>technical information used to support the proposal</w:t></w:r><w:r w:rsidR="00BC2AED"><w:t xml:space="preserve"> and requested that we add language clarifying the discussion of  new versus  modified and reconstructed sources in the preamble.</w:t></w:r></w:p><w:p w14:paraId="6A582AF7" w14:textId="77777777" w:rsidR="00BC2AED" w:rsidRDefault="00BC2AED"/><w:p w14:paraI