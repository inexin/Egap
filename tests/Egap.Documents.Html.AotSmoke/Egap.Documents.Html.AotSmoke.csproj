<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Published with Native AOT to check Egap.Documents.Html's trim and AOT claim. Rooting the add-on makes the trim and AOT
    analyzers check every code path in it and in AngleSharp; warnings are errors, so any warning fails the publish.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Egap.Documents.Html\Egap.Documents.Html.csproj" />
    <TrimmerRootAssembly Include="Egap.Documents.Html" />
  </ItemGroup>

</Project>
