<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests that measure the process's managed memory. They live in their own test process, so no other test runs beside them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../files/fonts/NotoSans-Latin.ttf" LinkBase="files/fonts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Egap.Pdf\Egap.Pdf.csproj" />
  </ItemGroup>

</Project>
