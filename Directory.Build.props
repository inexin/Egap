<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Lars Dytterud</Authors>
    <Copyright>Copyright (c) 2026 Lars</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/inexin/Egap</PackageProjectUrl>
    <RepositoryUrl>https://github.com/inexin/Egap</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- One version for every Egap package: Egap.Pdf, Egap.Documents and its add-ons, and Egap.Preview. They release together
         on the tag v<version>. -->
    <EgapVersion>2.2.0</EgapVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
