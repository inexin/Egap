<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Egami is not on nuget.org yet, so its packages come from a folder feed beside this checkout, made by tools/pack-egami.py
    from an exact Egami commit (Phase 3 design Q2). Source mapping keeps Egami packages to that feed and everything else to
    nuget.org, so a package of the same name elsewhere is never picked up.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="egami-local" value="../egami-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="egami-local">
      <package pattern="Egami" />
      <package pattern="Egami.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
