<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Every package, Egami's included, comes from nuget.org. To build against an unreleased Egami commit, pack it with
    tools/pack-egami.py and add its folder at restore: dotnet build -p:RestoreAdditionalProjectSources=../egami-feed
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
