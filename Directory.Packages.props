<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Egami from the local feed (nuget.config, written by tools/pack-egami.py with its update option). -->
    <PackageVersion Include="Egami" Version="1.0.0-local.g0d2e620" />
    <PackageVersion Include="Egami.Drawing" Version="1.0.1-local.g0d2e620" />
    <PackageVersion Include="Egami.Fonts" Version="0.2.0-local.g0d2e620" />
    <PackageVersion Include="Egami.Metafiles" Version="0.1.0-local.g0d2e620" />
    <PackageVersion Include="Egami.Css" Version="0.2.0-local.g0d2e620" />
    <PackageVersion Include="Egami.Svg" Version="0.1.0-local.g0d2e620" />
    <!--
      Phase 5 signatures (design Q2): CMS, CmsSigner and RFC 3161 from Microsoft's own package (MIT, dotnet/runtime), which
      .NET 10's base framework does not include (checked in task 1: the Microsoft.NETCore.App 10.0 reference pack has
      System.Formats.Asn1 and System.Security.Cryptography but not .Pkcs).
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
    <PackageVersion Include="xunit.v3" Version="3.1.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>