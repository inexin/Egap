<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Egami from nuget.org; tools/pack-egami.py can point these at a local build of an unreleased Egami commit. -->
    <PackageVersion Include="Egami" Version="1.2.0" />
    <PackageVersion Include="Egami.Drawing" Version="1.2.0" />
    <PackageVersion Include="Egami.Fonts" Version="1.2.0" />
    <PackageVersion Include="Egami.Fonts.Substitutes" Version="1.0.0" />
    <PackageVersion Include="Egami.Metafiles" Version="1.0.0" />
    <PackageVersion Include="Egami.Css" Version="1.2.0" />
    <PackageVersion Include="Egami.Svg" Version="1.2.0" />
    <PackageVersion Include="Egami.Barcodes" Version="1.0.0" />
    <!-- The egap command (CLI design Q14): egami's command host as a source package, on the Egami train, unlisted on nuget.org. -->
    <PackageVersion Include="Egami.Cli.Host" Version="1.2.0" />
    <!-- The command line and the MCP server under egap (CLI design Q4, Q16), as in egami. -->
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.3.0" />
    <!--
      Phase 5 signatures (design Q2): CMS, CmsSigner and RFC 3161 from Microsoft's own package (MIT, dotnet/runtime), which
      .NET 10's base framework does not include (checked in task 1: the Microsoft.NETCore.App 10.0 reference pack has
      System.Formats.Asn1 and System.Security.Cryptography but not .Pkcs).
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!--
      Approved third-party packages for the format add-ons only (docs/references.md). Minimum versions: raise them on purpose,
      with a full test run.
    -->
    <PackageVersion Include="AngleSharp" Version="1.8.5" />
    <PackageVersion Include="Markdig" Version="1.4.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>